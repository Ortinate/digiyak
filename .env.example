# ==========================================================
# Digiyak — Local & Production Environment Template
# Copy this file to `.env` and fill in values before running.
# ==========================================================

# PostgreSQL 17 + PostGIS
POSTGRES_DB=digiyak
POSTGRES_USER=digiyak
POSTGRES_PASSWORD=digiyak_dev_password
DATABASE_URL=jdbc:postgresql://localhost:5432/digiyak

# Redis 7 (GEO Live Tracking + Pub/Sub SSE + Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Server & JWT Auth
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=change-me-to-a-64-byte-random-secret-key-for-local-development-only
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# Payment Gateway (`mock` for instant local sandbox, `paystack` for live Ghana MoMo)
DIGIYAK_PAYMENT_PROVIDER=mock
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_WEBHOOK_SECRET=whsec_replace_me

# Default Campus Economics (basis points & pesewas)
DIGIYAK_DEFAULT_PLATFORM_CUT_BPS=1500
DIGIYAK_DEFAULT_RUNNER_CASH_CREDIT_LIMIT_PESEWAS=1000

# Frontend (Next.js PWA + MapLibre OpenFreeMap)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
